# ── App ───────────────────────────────────────────────────────────────────────
APP_TITLE=AI Cyber Strategy Analyst Assistant
APP_VERSION=1.0.0
APP_HOST=0.0.0.0
APP_PORT=8000

# ── OpenAI ──────────────────────────────────────────────────────────────────
# Replace with your actual OpenAI API key
OPENAI_API_KEY=sk-...
# GPT model used for strategy analysis (gpt-4o, gpt-4o-mini, gpt-4-turbo, etc.)
OPENAI_MODEL=gpt-4o-mini
# Temperature for LLM responses (0.0 = deterministic, 1.0 = creative)
LLM_TEMPERATURE=0.0

# ── Qdrant (Vector Database) ────────────────────────────────────────────────
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=cyber_docs

# ── Embedding ────────────────────────────────────────────────────────────────
# OpenAI embedding model for vectorizing documents
EMBEDDING_MODEL=text-embedding-3-small
# Dimensionality of the embedding vectors (must match the model)
EMBEDDING_DIM=1536
# Number of texts to embed per API call
EMBEDDING_BATCH_SIZE=50

# ── Storage ──────────────────────────────────────────────────────────────────
# Directory for persisted JSON data (documents registry, strategy results)
DATA_DIR=data
# Directory for uploaded file storage
UPLOADS_DIR=data/uploads

# ── Chunking ─────────────────────────────────────────────────────────────────
# Default chunk size in characters (overridden per-framework automatically)
DEFAULT_CHUNK_SIZE=700
# Default overlap between chunks in characters
DEFAULT_CHUNK_OVERLAP=100

# ── Retrieval ────────────────────────────────────────────────────────────────
# Number of top relevant chunks to retrieve from vector search
DEFAULT_TOP_K=8

# ── Document Processing ─────────────────────────────────────────────────────
# Minimum characters per PDF page to include (skips cover/image pages below this)
MIN_PAGE_CHARS=200

# ── PowerPoint Branding ─────────────────────────────────────────────────────
# Copyright text shown in slide footer
PPTX_COPYRIGHT=Copyright © 2026 Accenture. All rights reserved.
# Font family used in generated slides
PPTX_FONT=Arial

# ── Allowed File Types & Categories ─────────────────────────────────────────
# Comma-separated list of allowed upload file extensions
ALLOWED_EXTENSIONS=.pdf,.docx,.txt
# Comma-separated list of allowed document categories
ALLOWED_CATEGORIES=audit,risk,incident,business,iso,nist,cis,gdpr
